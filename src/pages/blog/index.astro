---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import PostCard from '../../components/PostCard.astro';

const allPosts = await getCollection('posts');
const posts = allPosts.sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime()
);
---

<PageLayout
  title="Blog — Eu Te Indico"
  description="Análises, comparativos e guias de compra dos melhores produtos da Amazon."
>
  <div class="max-w-6xl mx-auto px-4 py-12">
    <div class="mb-8">
      <h1 class="text-3xl font-black text-gray-900 mb-2">Blog</h1>
      <p class="text-gray-600">Análises, comparativos e guias para você comprar melhor.</p>
    </div>

    {posts.length === 0 ? (
      <p class="text-center text-gray-500 py-20">Nenhum post publicado ainda.</p>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {posts.map((post) => (
          <PostCard
            title={post.data.title}
            slug={post.id}
            excerpt={post.data.excerpt}
            image={post.data.image}
            category={post.data.category}
            publishedAt={post.data.publishedAt}
            readingTime={post.data.readingTime}
          />
        ))}
      </div>
    )}
  </div>
</PageLayout>
