---
import { getCollection, render } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const { title, excerpt, category, image, imageAlt, publishedAt, readingTime } = post.data;

const siteUrl = 'https://euteindico.com';
const postUrl = `${siteUrl}/blog/${post.id}`;

const dateStr = publishedAt.toLocaleDateString('pt-BR', {
  day: '2-digit',
  month: 'long',
  year: 'numeric',
});

const categoryLabels: Record<string, string> = {
  eletronicos: 'Eletrônicos',
  casa: 'Casa & Cozinha',
  esportes: 'Esportes',
  informatica: 'Informática',
  beleza: 'Beleza',
  livros: 'Livros',
};

const articleSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      '@id': `${postUrl}#article`,
      headline: title,
      description: excerpt,
      image: image.startsWith('http') ? image : `${siteUrl}${image}`,
      datePublished: publishedAt.toISOString(),
      dateModified: publishedAt.toISOString(),
      author: {
        '@type': 'Organization',
        name: 'Eu Te Indico',
        url: siteUrl,
      },
      publisher: {
        '@type': 'Organization',
        name: 'Eu Te Indico',
        url: siteUrl,
        logo: {
          '@type': 'ImageObject',
          url: `${siteUrl}/logo.svg`,
        },
      },
      mainEntityOfPage: { '@type': 'WebPage', '@id': postUrl },
      articleSection: categoryLabels[category] ?? category,
      inLanguage: 'pt-BR',
      timeRequired: `PT${readingTime}M`,
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Início', item: siteUrl },
        { '@type': 'ListItem', position: 2, name: 'Blog', item: `${siteUrl}/blog` },
        { '@type': 'ListItem', position: 3, name: title, item: postUrl },
      ],
    },
  ],
};
---

<PageLayout
  title={`${title} — Eu Te Indico`}
  description={excerpt}
  image={image}
  type="article"
  publishedAt={publishedAt}
  schema={articleSchema}
>
  <article class="max-w-4xl mx-auto px-4 py-12">
    <!-- Breadcrumb -->
    <nav class="text-sm text-gray-500 mb-6 flex items-center gap-2">
      <a href="/" class="hover:text-amber-600">Início</a>
      <span>/</span>
      <a href="/blog" class="hover:text-amber-600">Blog</a>
      <span>/</span>
      <span class="text-gray-800 truncate max-w-xs">{title}</span>
    </nav>

    <!-- Header -->
    <header class="mb-8">
      <span class="badge bg-amber-100 text-amber-700 mb-3 inline-block">
        {categoryLabels[category] ?? category}
      </span>
      <h1 class="text-3xl md:text-4xl font-black text-gray-900 mb-4 leading-tight">
        {title}
      </h1>
      <div class="flex items-center gap-3 text-sm text-gray-500 flex-wrap">
        <span>{dateStr}</span>
        <span>·</span>
        <span>{readingTime} min de leitura</span>
      </div>
    </header>

    <!-- Cover image -->
    <img
      src={image}
      alt={imageAlt ?? title}
      class="w-full rounded-2xl mb-10 aspect-video object-cover"
    />

    <!-- Content -->
    <div class="prose max-w-none">
      <Content />
    </div>

    <!-- Back link -->
    <div class="mt-12 pt-6 border-t border-gray-200">
      <a href="/blog" class="btn-secondary text-sm">← Voltar ao Blog</a>
    </div>

    <!-- Affiliate disclosure -->
    <div class="mt-8 p-4 bg-gray-50 border border-gray-200 rounded-xl text-xs text-gray-500">
      <strong>Divulgação:</strong> Este artigo pode conter links de afiliado da Amazon, Mercado Livre e Shopee.
      Se você comprar através deles, recebemos uma pequena comissão sem custo adicional para você.
    </div>
  </article>
</PageLayout>
