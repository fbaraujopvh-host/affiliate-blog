---
import { getCollection } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import ProductCard from '../components/ProductCard.astro';

const allProducts = await getCollection('products');
const products = allProducts.sort((a, b) => {
  // Destaque primeiro, depois por rating
  if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
  return b.data.rating - a.data.rating;
});
---

<PageLayout
  title="Melhores Produtos — Eu Te Indico"
  description="Os produtos mais bem avaliados da Amazon selecionados pela nossa equipe. Atualizados diariamente."
>
  <div class="max-w-6xl mx-auto px-4 py-12">
    <div class="text-center mb-10">
      <h1 class="text-3xl md:text-4xl font-black text-gray-900 mb-3">
        ⭐ Produtos que Eu Te Indico
      </h1>
      <p class="text-gray-600 max-w-xl mx-auto">
        Selecionados com base em avaliações dos compradores, custo-benefício e qualidade comprovada.
        Atualizado em {new Date().toLocaleDateString('pt-BR', { month: 'long', year: 'numeric' })}.
      </p>
    </div>

    {products.length === 0 ? (
      <p class="text-center text-gray-500 py-20">Nenhum produto cadastrado ainda.</p>
    ) : (
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
        {products.map((p) => <ProductCard {...p.data} />)}
      </div>
    )}

    <p class="text-center text-xs text-gray-400 mt-10">
      Participante do Programa de Associados da Amazon. Ao comprar pelos nossos links,
      recebemos uma comissão sem custo adicional para você.
    </p>
  </div>
</PageLayout>
