---
import { getCollection } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import PostCard from '../components/PostCard.astro';
import ProductCard from '../components/ProductCard.astro';

// Lê dados do CMS
const allPosts = await getCollection('posts');
const allProducts = await getCollection('products');
const paginasCollection = await getCollection('paginas');
const categoriasCollection = await getCollection('categorias');

const recentPosts = allPosts
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  .slice(0, 3);

const featuredProducts = allProducts
  .filter(p => p.data.featured)
  .slice(0, 3);

// Configurações da home editáveis pelo CMS
const homeData = paginasCollection.find(p => p.id === 'home')?.data;
const hero = {
  badge: homeData?.heroBadge ?? 'Análises independentes e honestas',
  title: homeData?.heroTitle ?? 'Encontre o Produto Perfeito',
  subtitle: homeData?.heroSubtitle ?? 'sem perder tempo pesquisando',
  description: homeData?.heroDescription ?? 'Indicamos os melhores produtos para que você compre com confiança.',
  cta1Label: homeData?.heroCta1Label ?? 'Ver Melhores Produtos',
  cta1Url: homeData?.heroCta1Url ?? '/melhores-produtos',
  cta2Label: homeData?.heroCta2Label ?? 'Ler Análises',
  cta2Url: homeData?.heroCta2Url ?? '/blog',
};

const rawCategories = categoriasCollection.find(c => c.id === 'categorias')?.data.items ?? [];
const categories = rawCategories.map(c => ({
  name: c.name,
  icon: c.icon,
  href: `/categoria/${c.slug}`,
}));
---

<PageLayout
  title="Eu Te Indico — As melhores indicações de produtos"
  description={hero.description}
>
  <!-- Hero -->
  <section class="bg-gradient-to-br from-amber-50 to-white border-b border-amber-100 py-16">
    <div class="max-w-6xl mx-auto px-4 text-center">
      <span class="badge bg-amber-100 text-amber-700 mb-4 inline-block">{hero.badge}</span>
      <h1 class="text-4xl md:text-5xl font-black text-gray-900 mb-4 leading-tight">
        {hero.title}<br />
        <span class="text-amber-500">{hero.subtitle}</span>
      </h1>
      <p class="text-lg text-gray-600 mb-8 max-w-2xl mx-auto">{hero.description}</p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href={hero.cta1Url} class="btn-primary text-base px-6 py-3">{hero.cta1Label}</a>
        <a href={hero.cta2Url} class="btn-secondary text-base px-6 py-3">{hero.cta2Label}</a>
      </div>
    </div>
  </section>

  <!-- Categories -->
  <section class="max-w-6xl mx-auto px-4 py-12">
    <h2 class="text-2xl font-bold text-gray-900 mb-6">Categorias</h2>
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-3">
      {categories.map(({ name, icon, href }) => (
        <a href={href} class="card p-4 text-center hover:border-amber-200 group">
          <div class="text-3xl mb-2">{icon}</div>
          <p class="text-sm font-semibold text-gray-800 group-hover:text-amber-600 transition-colors">{name}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- Featured Products -->
  {featuredProducts.length > 0 && (
    <section class="bg-white border-y border-gray-100 py-12">
      <div class="max-w-6xl mx-auto px-4">
        <div class="flex items-center justify-between mb-6">
          <h2 class="text-2xl font-bold text-gray-900">Produtos em Destaque</h2>
          <a href="/melhores-produtos" class="text-sm text-amber-600 font-semibold hover:text-amber-800">Ver todos →</a>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-5">
          {featuredProducts.map((p) => <ProductCard {...p.data} />)}
        </div>
      </div>
    </section>
  )}

  <!-- Recent Posts -->
  {recentPosts.length > 0 && (
    <section class="max-w-6xl mx-auto px-4 py-12">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-2xl font-bold text-gray-900">Artigos Recentes</h2>
        <a href="/blog" class="text-sm text-amber-600 font-semibold hover:text-amber-800">Ver todos →</a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {recentPosts.map((post) => (
          <PostCard
            title={post.data.title}
            slug={post.id}
            excerpt={post.data.excerpt}
            image={post.data.image}
            category={post.data.category}
            publishedAt={post.data.publishedAt}
            readingTime={post.data.readingTime}
          />
        ))}
      </div>
    </section>
  )}

  <!-- Trust Bar -->
  <section class="bg-gray-900 text-white py-10">
    <div class="max-w-6xl mx-auto px-4">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        {[
          { icon: '🔍', label: 'Análises detalhadas', desc: 'Testamos cada produto' },
          { icon: '⭐', label: '+200 produtos', desc: 'Avaliados e comparados' },
          { icon: '💰', label: 'Sem custo extra', desc: 'Comissão não afeta o preço' },
          { icon: '🔄', label: 'Atualizado sempre', desc: 'Preços e análises frescos' },
        ].map(({ icon, label, desc }) => (
          <div>
            <div class="text-3xl mb-2">{icon}</div>
            <p class="font-semibold">{label}</p>
            <p class="text-sm text-gray-400 mt-1">{desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</PageLayout>
