---
import { getCollection } from 'astro:content';

const year = new Date().getFullYear();

const rodapeCollection = await getCollection('rodape');
const rodapeData = rodapeCollection.find(r => r.id === 'rodape')?.data;

const descricao = rodapeData?.descricao ?? 'Indicações honestas dos melhores produtos para você comprar com confiança e economizar tempo.';
const colunas = rodapeData?.colunas ?? [];
---

<footer class="bg-gray-900 text-gray-400 mt-16">
  <div class="max-w-6xl mx-auto px-4 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Brand -->
      <div>
        <a href="/" class="flex items-center gap-2 font-bold text-lg text-white mb-3">
          <span class="bg-amber-500 text-white rounded-lg w-8 h-8 flex items-center justify-center flex-shrink-0">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12" />
            </svg>
          </span>
          Eu Te Indico
        </a>
        <p class="text-sm leading-relaxed">{descricao}</p>
      </div>

      <!-- Links -->
      {colunas.map(({ titulo, links }) => (
        <div>
          <h3 class="text-white font-semibold mb-3">{titulo}</h3>
          <ul class="space-y-2">
            {links.map(({ href, label }) => (
              <li>
                <a href={href} class="text-sm hover:text-amber-400 transition-colors">{label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="border-t border-gray-800 mt-10 pt-6 flex flex-col md:flex-row items-center justify-between gap-3 text-xs">
      <p>&copy; {year} Eu Te Indico. Todos os direitos reservados.</p>
      <p class="text-center">
        Participantes do Programa de Afiliados da Amazon, Mercado Livre e Shopee. Ao comprar pelos nossos links, recebemos uma comissão sem custo adicional para você.
      </p>
    </div>
  </div>
</footer>
